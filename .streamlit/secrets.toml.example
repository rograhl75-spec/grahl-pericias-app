# Crie o arquivo real `.streamlit/secrets.toml` apenas no seu ambiente local
# ou nos secrets da plataforma de hospedagem. Nunca versione esse arquivo com
# chaves reais no repositório.

[anthropic]
api_key = "YOUR_ANTHROPIC_API_KEY"

[firebase]
# Preencha com as credenciais da service account usadas pelo app.
type = "service_account"
project_id = "YOUR_FIREBASE_PROJECT_ID"
private_key_id = "YOUR_FIREBASE_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxx@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com"
client_id = "YOUR_FIREBASE_CLIENT_ID"
token_uri = "https://oauth2.googleapis.com/token"

[app]
# Limites e parâmetros atuais do fluxo PDF -> Claude -> Firestore.
max_api_calls_per_day = 50
max_file_size_mb = 200
max_single_pdf_size_mb = 75
max_pdf_files = 5
# Padrão: 3000 páginas e 1.200.000 caracteres por importação. Mantenha
# max_pdf_chars_total <= claude_chunk_chars * claude_max_chunks (120000 * 10).
# Acima do limite a importação única é bloqueada sem alterar o processo e o app
# oferece a importação em lotes (opt-in, botão "Processar em lotes").
# Reduza estes valores se a instância do Streamlit Cloud ficar sem memória.
max_pdf_pages_total = 3000
max_pdf_chars_total = 1200000
# Importação em lotes: os PDFs são divididos por intervalos de páginas em até
# max_pdf_batches lotes de no máximo max_pdf_chars_total caracteres cada, analisados
# um por vez (cada lote valida e reserva a cota diária de chamadas e de custo) e
# mesclados sem chamada extra à Claude. Se qualquer lote falhar, nada é importado.
# Use pdf_batch_import_enabled = false para manter apenas o bloqueio.
pdf_batch_import_enabled = true
max_pdf_batches = 4
claude_chunk_chars = 120000
claude_max_chunks = 10
claude_model = "claude-3-5-sonnet-20241022"
cost_limit_per_day = 250.00
usd_brl_exchange_rate = 5.00
environment = "production"

# Cada modelo configurado em `claude_model` precisa de preços correspondentes.
[app.claude_model_pricing.claude-3-5-sonnet-20241022]
input_usd_per_million_tokens = 3.00
output_usd_per_million_tokens = 15.00
