# EXEMPLO DE CONFIGURAÇÃO DE SECRETS
# COPIE ESTE ARQUIVO COMO secrets.toml E PREENCHA COM SUAS CREDENCIAIS
# NUNCA COMMITE secrets.toml NO GIT!

[anthropic]
# Sua chave API da Anthropic - gere em https://console.anthropic.com/account/keys
api_key = "sk-ant-..."

[app]
# Limites de segurança
max_api_calls_per_day = 50          # Máximo 50 processos por dia
max_file_size_mb = 200              # Máximo 200MB por arquivo
max_pdf_files = 5                   # Máximo 5 PDFs por processo
cost_limit_per_day = 250.00         # Máximo R$ 250,00 de gasto por dia
environment = "production"          # "development" ou "production"

[firebase]
# Firebase já está configurado - use as credenciais de st.secrets
# Adicione aqui se precisar sobrescrever

[logging]
# Configurações opcionais de log
log_level = "INFO"                  # "DEBUG", "INFO", "WARNING", "ERROR"
log_api_calls = true                # Registrar chamadas à API
log_token_usage = true              # Registrar uso de tokens
